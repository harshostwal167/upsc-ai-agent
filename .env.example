# UPSC AI Agent - Environment Configuration Template
# Copy this to .env and fill in your actual values
# IMPORTANT: Never commit .env to git

# ============================================================================
# REQUIRED: Anthropic API Configuration
# ============================================================================
# Get your API key from: https://console.anthropic.com
# Sign up → Click "API Keys" → Create new key → Copy here
ANTHROPIC_API_KEY=sk-ant-your-actual-key-here

# ============================================================================
# OPTIONAL: Flask Configuration
# ============================================================================
# Environment: development or production
FLASK_ENV=production

# Debug mode (disable in production)
FLASK_DEBUG=False

# Flask secret key (for sessions if needed)
FLASK_SECRET_KEY=your-secret-key-here-change-this

# ============================================================================
# OPTIONAL: Database Configuration
# ============================================================================
# SQLite path (default is current directory)
DATABASE_PATH=upsc_articles.db

# For PostgreSQL (if migrating to production)
# DATABASE_URL=postgresql://username:password@localhost:5432/upsc_agent

# ============================================================================
# OPTIONAL: Scheduler Configuration
# ============================================================================
# Hour for daily update (24-hour format, IST)
# 6 = 6:00 AM IST
# 7 = 7:00 AM IST
UPDATE_HOUR=6
UPDATE_MINUTE=0

# Timezone (keep as IST for India)
TIMEZONE=Asia/Kolkata

# ============================================================================
# OPTIONAL: News Sources Configuration
# ============================================================================
# Add custom RSS feed URLs (JSON format)
# CUSTOM_FEEDS={"name1": "url1", "name2": "url2"}
CUSTOM_FEEDS={}

# ============================================================================
# OPTIONAL: Email Configuration (for daily digest emails)
# ============================================================================
# Enable email notifications (true/false)
ENABLE_EMAIL_NOTIFICATIONS=false

# SMTP Server
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True

# Email credentials
EMAIL_SENDER=your-email@gmail.com
# For Gmail: Use App Password, not regular password
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=app-specific-password-here

# Recipient email for digest
DIGEST_RECIPIENT=your-study-group@gmail.com

# ============================================================================
# OPTIONAL: Logging Configuration
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=upsc_backend.log

# ============================================================================
# OPTIONAL: Server Configuration
# ============================================================================
# Server host (0.0.0.0 for production, localhost for development)
SERVER_HOST=0.0.0.0

# Server port
SERVER_PORT=5000

# ============================================================================
# OPTIONAL: Frontend Configuration
# ============================================================================
# API base URL (used by React frontend)
API_BASE_URL=http://localhost:5000/api

# For production deployment:
# API_BASE_URL=https://upsc-ai-agent.onrender.com/api

# ============================================================================
# OPTIONAL: Advanced Categorization
# ============================================================================
# Minimum relevance score for articles (1-10)
MIN_RELEVANCE_SCORE=5

# Filter only articles with relevance >= this threshold
RELEVANCE_THRESHOLD=medium

# ============================================================================
# OPTIONAL: Rate Limiting
# ============================================================================
# Requests per minute for API endpoints
API_RATE_LIMIT=60

# ============================================================================
# OPTIONAL: Cache Configuration
# ============================================================================
# Cache articles for this many minutes
CACHE_TTL_MINUTES=30

# ============================================================================
# NOTES FOR SETUP
# ============================================================================
# 1. Create a .env file in your project root
# 2. Copy this template
# 3. Fill in ANTHROPIC_API_KEY (required)
# 4. Other settings are optional, defaults will be used
# 5. NEVER commit .env to git (add to .gitignore)
# 6. For production, use environment variables instead of .env file

# ============================================================================
# SECURITY NOTES
# ============================================================================
# - Keep ANTHROPIC_API_KEY secret
# - Use App Passwords for Gmail, not main password
# - Change FLASK_SECRET_KEY if using sessions
# - Disable FLASK_DEBUG in production
# - Use strong passwords for database connections
# - Use HTTPS in production
